# Copy this file to .env (same folder) and fill in the values. .env is ignored by Git.
# Generate a JWT secret with: openssl rand -hex 32

# JWT: the same secret in every service (min. 64 characters for HS512)
JWT_SECRET=change-me
JWT_EXPIRATION=3600000

# MySQL
DB_USER=root
DB_PASSWORD=

# First admin (only used when pets_users has no ADMIN yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@adoptapet.com

# RabbitMQ (guest/guest only works from localhost)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# CORS (api-gateway, optional): comma separated origins of the web frontend
# CORS_ALLOWED_ORIGINS=http://localhost:4200
