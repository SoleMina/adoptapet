# Copy to the repo root as .env on the server (next to docker-compose.yml). Ignored by Git.

# Public name of the server. Without a domain use the IP with dashes + .sslip.io (129.146.10.20 -> 129-146-10-20.sslip.io)
DOMAIN=129-146-10-20.sslip.io

# Internal passwords of MySQL (root) and RabbitMQ. Generate each with: openssl rand -hex 16
MYSQL_ROOT_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
